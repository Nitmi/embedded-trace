{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embedded-trace:input:v1",
  "title": "Explicit saved-log correlation inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "embedded-trace.input.v1"},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "format", "path", "sha256", "clock_domain"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "clock_domain": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "format": {"enum": ["baud-jsonl", "rtt-jsonl", "sim-runner-report"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
