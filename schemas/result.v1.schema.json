{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embedded-trace:result:v1",
  "title": "Host-only CLI result",
  "type": "object",
  "required": ["schema_version", "operation", "ok", "scope", "hardware_access", "executables_started", "authorization_granted", "hardware_identity_verified", "runtime_firmware_identity_verified", "cross_source_clock_alignment_verified", "target_event_time_verified"],
  "properties": {
    "schema_version": {"const": "embedded-trace.result.v1"},
    "operation": {"enum": ["trace.correlate", "trace.inspect", "trace.query"]},
    "ok": {"type": "boolean"},
    "scope": {"const": "host_only_saved_log_correlation"},
    "hardware_access": {"const": false},
    "executables_started": {"const": false},
    "authorization_granted": {"const": false},
    "hardware_identity_verified": {"const": false},
    "runtime_firmware_identity_verified": {"const": false},
    "cross_source_clock_alignment_verified": {"const": false},
    "target_event_time_verified": {"const": false},
    "data": {"type": "object"},
    "error": {"type": "object", "required": ["code", "message"], "properties": {
      "code": {"type": "string"}, "message": {"type": "string"}
    }}
  },
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}}, "then": {"required": ["data"]}},
    {"if": {"properties": {"ok": {"const": false}}}, "then": {"required": ["error"]}}
  ]
}
